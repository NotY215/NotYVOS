# NotYVOS kernel changes: the kernel never shows text, a logo or a console.
CONFIG_LOGO=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_VT_CONSOLE=n
CONFIG_VT=y
CONFIG_MAGIC_SYSRQ=n
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=0
CONFIG_CONSOLE_LOGLEVEL_QUIET=0
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=0
# Graphics and input needed by the XMB session
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_NOUVEAU=y
CONFIG_INPUT_EVDEV=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_JOYDEV=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
